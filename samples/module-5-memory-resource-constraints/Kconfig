# For Iomico Zephyr Intermediate course, homework 5 task 1
# (tag l5-task1)

config SUBSCRIBER_QUEUE_SIZE
	int "Size of a demonstration subscriber message queue"
	range 1 128
	default 5
	help
	  Set the size of a message subscriber queue.  Message is arbitrary data
	  not limited to printable characters.

config SENSOR_READING_COUNT
	int "Number of simulated sensor readings to publish"
	default 18
	help
	  Number of simulated sensor readings to publish on a zbus channel.

config PUBLISHER_PERIOD_MS
	int "Interval at which l5-task1 sensor data publisher emits new message"
	default 150
	help
	  Interval at which l5-task1 sensor data publisher emits new message,
	  with simulated sensor data.

config SUBSCRIBER_WDT_TIMEOUT_MS
	int "Task watchdog timeout in milliseconds, for message subscriber thread."
	default 2000
	help
	  Task watchdog timeout in milliseconds, for message subscriber thread.

config SUBSCRIBER_SIMULATED_WORK_DELAY_MS
	int "Delay added at end of l5-task1 subscriber thread, in milliseconds"
	default 100
	help
	  Delay added at end of l5-task1 subscriber thread, in milliseconds,
	  to simulate long running work.

source "Kconfig.zephyr"
